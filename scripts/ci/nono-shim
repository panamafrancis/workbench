#!/usr/bin/env bash
# Fallback nono shim for CI environments where Landlock is not available.
# Parses: nono run --profile <p> [--allow|--read|--allow-file|--read-file <path>]... -- <cmd> [args...]
# Strips nono flags and exec's the command directly (no sandboxing).
set -euo pipefail

while [ $# -gt 0 ]; do
    case "$1" in
        run|-s|--silent|--no-rollback) shift ;;
        --profile|--allow|--read|--write|--allow-file|--read-file|--write-file) shift; shift ;;
        --)        shift; break ;;
        *)         break ;;
    esac
done

exec "$@"
